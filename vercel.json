{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "node",
  "regions": [
    "icn1"
  ],
  "rewrites": [
    {
      "destination": "/career-log-ingest",
      "source": "/api/career-log/ingest"
    },
    {
